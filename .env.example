# --- Secrets (host secret store in production; never commit) ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Read-only Trello REST credentials for the trello_work_history custom tool. Required only when the
# serving release exposes that tool (r26). The token must be issued with scope=read (docs/52 §5).
TRELLO_API_KEY=
TRELLO_READ_TOKEN=

# --- Non-secret configuration ---
# Your own Telegram numeric user id: the single-user allowlist.
TELEGRAM_ALLOWED_USER_ID=
# Expiry recorded when the Trello read token was issued: ISO date (e.g. 2026-10-22) or "never".
# Startup warns 7 days ahead; without it expiry cannot be warned about.
TRELLO_READ_TOKEN_EXPIRES_AT=

# --- Optional ---
# The Agent/environment/Memory/vault ids now come from the reviewed release (src/release.ts). These legacy
# variables may stay; if set, they must equal the release values or startup refuses to serve.
DJONIK_AGENT_ID=
DJONIK_ENVIRONMENT_ID=
DJONIK_MEMORY_STORE_ID=
DJONIK_VAULT_ID=
# Host assertion of which release the deployed revision must serve (e.g. r26); mismatch refuses to start.
DJONIK_EXPECTED_RELEASE=
# Deployed commit; defaults to git HEAD (+dirty) when running from a checkout.
DJONIK_APP_REVISION=
# Graceful-stop drain for in-flight turns, ms (5000–600000, default 120000).
DJONIK_SHUTDOWN_DRAIN_MS=
# Content-free diagnostics.
DJONIK_TRACE=
DJONIK_TURN_TELEMETRY=
